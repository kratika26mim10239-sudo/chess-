# Chess Board Setup
board = [
    ["r", "n", "b", "q", "k", "b", "n", "r"],
    ["p", "p", "p", "p", "p", "p", "p", "p"],
    [" ", " ", " ", " ", " ", " ", " ", " "],
    [" ", " ", " ", " ", " ", " ", " ", " "],
    [" ", " ", " ", " ", " ", " ", " ", " "],
    [" ", " ", " ", " ", " ", " ", " ", " "],
    ["P", "P", "P", "P", "P", "P", "P", "P"],
    ["R", "N", "B", "Q", "K", "B", "N", "R"]
]

def print_board():
    print("\n  a b c d e f g h")
    for i in range(8):
        print(8 - i, " ".join(board[i]))
    print()

def move_piece(start, end):
    # Convert inputs like 'e2' to matrix coordinates (row, col)
    start_col, start_row = ord(start[0]) - 97, 8 - int(start[1])
    end_col, end_row = ord(end[0]) - 97, 8 - int(end[1])
    
    # Move piece
    board[end_row][end_col] = board[start_row][start_col]
    board[start_row][start_col] = " "

# Main Game Loop
turn = "White (UPPERCASE)"
while True:
    print_board()
    print(f"Current turn: {turn}")
    
    start = input("From square (e.g., e2) or 'exit': ").strip().lower()
    if start == "exit":
        break
    end = input("To square (e.g., e4): ").strip().lower()
    
    try:
        move_piece(start, end)
        turn = "Black (lowercase)" if "White" in turn else "White (UPPERCASE)"
    
